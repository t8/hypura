<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Apple App Sandbox (MANDATORY for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allow binding local server socket (e.g. port 6000) for OpenAI and Ollama APIs -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow outgoing network connections for pulling model weights and checking updates -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow reading and writing user-selected folders/files (e.g. models directory chosen via Browse button) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow JIT and dynamic executable code for Metal shader compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>

